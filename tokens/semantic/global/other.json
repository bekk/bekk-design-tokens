{
  "border-width": {
    "default": {
      "$type": "dimension",
      "$value": "1px"
    },
    "highlight": {
      "$type": "dimension",
      "$value": "2px"
    },
    "focus": {
      "$type": "dimension",
      "$value": "4px"
    }
  },
  "font": {
    "family": {
      "base": {
        "$type": "fontFamily",
        "$value": "GT America"
      },
      "display": {
        "$type": "fontFamily",
        "$value": "GT America"
      },
      "action": {
        "$type": "fontFamily",
        "$value": "GT America"
      }
    },
    "weight": {
      "light": {
        "$type": "fontWeight",
        "$value": "Light"
      },
      "regular": {
        "$type": "fontWeight",
        "$value": "Regular"
      },
      "medium": {
        "$type": "fontWeight",
        "$value": "Medium"
      },
      "expanded-medium": {
        "$type": "fontWeight",
        "$value": "Expanded Medium"
      },
      "light-italic": {
        "$type": "fontWeight",
        "$value": "Light Italic"
      },
      "medium-italic": {
        "$type": "fontWeight",
        "$value": "Medium Italic"
      },
      "regular-italic": {
        "$type": "fontWeight",
        "$value": "Regular Italic"
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "150ms"
      },
      "default": {
        "$type": "duration",
        "$value": "200ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "300ms"
      },
      "slower": {
        "$type": "duration",
        "$value": "500ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "string",
        "$value": "cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "enter": {
        "$type": "string",
        "$value": "cubic-bezier(0, 0, 0.2, 1)"
      },
      "exit": {
        "$type": "string",
        "$value": "cubic-bezier(0.4, 0, 1, 1)"
      }
    }
  }
}