      "$value": "0px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "2px"
    },
    "md": {
      "$type": "dimension",
      "$value": "4px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "8px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "12px"
    },
    "full": {
